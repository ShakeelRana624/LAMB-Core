# LAMB Cognitive Operating System - Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================================
# Anthropic API Configuration (for LLM integration)
# ============================================================
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ============================================================
# Database Configuration
# ============================================================
# ChromaDB persistence path
CHROMA_PERSIST_DIR=./chroma_data

# ============================================================
# Model Configuration
# ============================================================
# Sentence Transformers model for embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ============================================================
# Memory Configuration
# ============================================================
# Salience threshold for memory storage (0.0-1.0)
SALIENCE_THRESHOLD=0.35

# Base stability for new memories (hours)
BASE_STABILITY=24.0

# Consolidation threshold (number of episodic memories)
CONSOLIDATION_THRESHOLD=10

# ============================================================
# API Configuration
# ============================================================
# FastAPI host and port
API_HOST=0.0.0.0
API_PORT=8000

# CORS settings
CORS_ORIGINS=*

# ============================================================
# Redis Configuration (optional, for distributed caching)
# ============================================================
# REDIS_URL=redis://localhost:6379/0

# ============================================================
# Logging Configuration
# ============================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============================================================
# Benchmark Configuration
# ============================================================
# Benchmark duration in seconds
BENCHMARK_DURATION=10

# Target requests per second
BENCHMARK_TARGET_RPS=1000
